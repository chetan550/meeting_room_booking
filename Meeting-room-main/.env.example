# ─── Database ────────────────────────────────────────────────────────────────
# DB_TYPE controls which database backend is used.
# Set to "mysql" to use MySQL/MariaDB, or leave unset to use SQLite (default).
DB_TYPE=sqlite

# SQLite — used when DB_TYPE is not set or is "sqlite"
# The database file is stored at ./database.sqlite in the project root.
# No additional configuration is needed for SQLite.

# MySQL / MariaDB — used when DB_TYPE=mysql
# Uncomment and fill in the values below to connect to a MySQL server.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=meeting_room_db
# ─── Server Ports ────────────────────────────────────────────────────────────────
# You can override the default HTTP and Vite dev server ports via environment variables.
# The Express server listens on PORT (default 3000). Vite uses VITE_PORT (default 5173).
# Example:
# PORT=3001
# VITE_PORT=3002
